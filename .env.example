# Copy this file to .env, then edit values.
# For local npm start, export variables in your shell or use: node --env-file=.env server.js
# Docker Compose reads this file automatically.
PORT=3000
NODE_ENV=development
DB_FILE=.storage/unlos.sqlite
# Leave DATA_FILE unset except when migrating an older unlos.json backup.
# Create a unique instructor account before running a client demo:
ADMIN_EMAIL=
ADMIN_PASSWORD=
