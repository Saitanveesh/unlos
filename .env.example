# ==============================================================================
# UNLOS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# In production on Vercel, configure these in:
#   Project Settings -> Environment Variables
# ==============================================================================

# Server configuration (Local dev only)
PORT=3000

# Application environment ('development' locally, 'production' on Vercel)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Instructor Admin Account (Optional on boot)
# Automatically registers an initial admin account if not already present.
# ------------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# Persistent Cloud SQLite Database (Turso / libSQL) - Recommended for Vercel
# Free tier provides 9 GB storage and keeps student registrations, enrollments,
# and progress persistent across serverless cold starts and container recycles.
# Obtain from: https://turso.tech/ or Turso CLI (`turso db create unlos-db`)
# ------------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Local Embedded SQLite Storage (Local Dev & Testing)
# Defaults to .storage/unlos.sqlite locally.
# On Vercel without Turso, falls back automatically to /tmp/unlos.sqlite.
# ------------------------------------------------------------------------------
DB_FILE=.storage/unlos.sqlite
