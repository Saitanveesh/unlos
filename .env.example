# Copy to .env and export these variables (Node.js does not load .env automatically).
PORT=3000
# Set an optional path outside the repository for persistent data:
DATA_FILE=.storage/unlos.json
# Optional instructor account, created on first boot; set both before startup:
ADMIN_EMAIL=
ADMIN_PASSWORD=
# On HTTPS deployments set NODE_ENV=production for Secure cookies.
NODE_ENV=development
